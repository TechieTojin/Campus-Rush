# Campus Rush Server - Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to Git.

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://your_username:your_password@your_cluster.mongodb.net/?retryWrites=true&w=majority

# JWT signing secret (use a strong random string in production)
JWT_SECRET=change_this_to_a_strong_random_secret

# OpenAI API key (for AI assistant feature)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Stripe secret key (server-side only, never expose to clients)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Server port (optional, defaults to 5001)
PORT=5001
