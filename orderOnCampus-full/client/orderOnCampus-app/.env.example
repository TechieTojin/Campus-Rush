# Campus Rush Mobile App - Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to Git.

# Stripe publishable key (safe to include in client bundle)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# API base URL (your backend server address)
EXPO_PUBLIC_API_URL=http://localhost:5001
